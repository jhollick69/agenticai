# ─── Supabase ───────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Project Settings → API → service_role (SECRET — server only, never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe ─────────────────────────────────────────────────────────────────
# Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxx
# Created when you run `stripe listen` locally, or from the Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs from Products → your subscription product (test mode)
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_ANNUAL=price_xxx

# ─── App ────────────────────────────────────────────────────────────────────
# Used to build absolute Checkout success/cancel URLs. Set to your deployed URL in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
